# Copy this file to .env and fill it in. Never share or commit .env.
DISCORD_TOKEN=paste-your-bot-token-here
# Right-click your server icon > Copy Server ID (needs Developer Mode on).
# The bot only works in this server and leaves any other server it is added to.
GUILD_ID=123456789012345678
# Optional: path to a cookies.txt exported from a browser, if YouTube blocks the bot.
YTDLP_COOKIES=
# Optional: seconds with nothing playing before the bot leaves the voice channel (0 = never).
IDLE_TIMEOUT=300
# Optional: most songs taken from one playlist link.
MAX_PLAYLIST=100
# Optional: starting volume in percent.
DEFAULT_VOLUME=50
# Optional: "on" to start with autoplay turned on (it can be toggled with /autoplay).
AUTOPLAY=off
